cabal-version:      2.4
name:               pacman
version:            0.1.0.0
author:             Max Harmsen and Mika Kalshoven
category:           Game
build-type:         Simple

executable pacman
  main-is:          main.hs
  hs-source-dirs:   .
  other-modules:    Game.Controller
                   , Game.GhostAI
                   , Game.Model
                   , Game.Types
                   , Game.View
  build-depends:    base >=4.14 && <5
                  , gloss >=1.13 && <2
                  ,random, directory
  default-language: Haskell2010
